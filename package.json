{
  "name": "nexora-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Nexora CRM npm monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@nexora/web",
    "dev:api": "npm run dev --workspace=@nexora/api",
    "build": "npm run build --workspace=@nexora/web",
    "lint": "npm run lint --workspace=@nexora/web",
    "start": "npm run start --workspace=@nexora/api"
  },
  "engines": {
    "node": ">=20"
  }
}
